root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false
max_line_length = off

[*.{json,yaml,yml}]
indent_style = space
indent_size = 2

[*.{gd,cs,cpp,h,py,js,ts}]
indent_style = tab
tab_width = 4
max_line_length = 120

[Makefile]
indent_style = tab
